<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="org.westlake.syncprobe">
 <uses-sdk android:minSdkVersion="22" android:targetSdkVersion="22" />
 <uses-permission android:name="android.permission.GET_ACCOUNTS" />
 <uses-permission android:name="android.permission.AUTHENTICATE_ACCOUNTS" />
 <uses-permission android:name="android.permission.READ_SYNC_SETTINGS" />
 <uses-permission android:name="android.permission.WRITE_SYNC_SETTINGS" />
 <uses-permission android:name="android.permission.READ_SYNC_STATS" />
 <application android:label="Westlake periodic sync probe" android:allowBackup="false">
  <activity android:name=".ProbeActivity" android:exported="true" android:theme="@android:style/Theme.NoDisplay">
   <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
  </activity>
  <provider android:name=".ProbeProvider" android:authorities="org.westlake.syncprobe.data" android:exported="false" />
  <service android:name=".ProbeService" android:exported="false" android:permission="android.permission.BIND_SYNC_ADAPTER">
   <intent-filter><action android:name="android.content.SyncAdapter" /></intent-filter>
   <meta-data android:name="android.content.SyncAdapter" android:resource="@xml/sync" />
  </service>
 </application>
</manifest>
